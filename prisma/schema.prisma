generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  BIDDER
  BUYER
  ADMIN
  MODERATOR
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

model User {
  id              Int            @id @default(autoincrement())
  username        String         @unique
  email           String         @unique
  password        String
  role            UserRole       @default(BUYER) // Primary role for backward compatibility
  firstName       String?
  lastName        String?
  phone           String?
  address         Json?
  reviewsGiven    Review[]       @relation("reviewsGiven")
  reviewsReceived Review[]       @relation("reviewsReceived")
  products        Product[]      @relation("UserProducts")
  bids            Bid[]
  ordersAsBuyer   Order[]        @relation("buyer")
  ordersAsSeller  Order[]        @relation("seller")
  messages        Message[]      @relation("UserMessages")
  notifications   Notification[]
  newsAuthored    News[]
  roleAssignments UserRoleAssignment[]
  exchangeRates   ExchangeRate[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  Watchlist       Watchlist[]
  CartItem        CartItem[]
  Dispute         Dispute[]
}

model Product {
  id            String            @id @default(cuid())
  title         String
  description   String
  seller        String
  imageUrl      String
  category      String            // Keep for backward compatibility
  condition     String
  location      String
  listingType   String
  startingPrice Float
  currentPrice  Float
  buyNowPrice   Float?
  endDate       DateTime
  user          User              @relation("UserProducts", fields: [userId], references: [id])
  userId        Int
  bids          Bid[]
  orders        Order[]
  watchlistedBy Watchlist[]
  categories    ProductCategory[] // New many-to-many relationship
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  CartItem      CartItem[]
}

model Bid {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  maxBid    Float
  timestamp DateTime @default(now())
}

model Order {
  id                 String    @id @default(cuid())
  product            Product   @relation(fields: [productId], references: [id])
  productId          String
  productTitle       String
  seller             User      @relation("seller", fields: [sellerId], references: [id])
  sellerId           Int
  buyer              User      @relation("buyer", fields: [buyerId], references: [id])
  buyerId            Int
  finalPrice         Float
  purchaseDate       DateTime  @default(now())
  status             String
  reviewLeftByBuyer  Boolean   @default(false)
  reviewLeftBySeller Boolean   @default(false)
  reviews            Review[]
  Dispute            Dispute[]
}

model Review {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  reviewer   User     @relation("reviewsGiven", fields: [reviewerId], references: [id])
  reviewerId Int
  reviewee   User     @relation("reviewsReceived", fields: [revieweeId], references: [id])
  revieweeId Int
  rating     Int
  comment    String?
  timestamp  DateTime @default(now())
}

model Conversation {
  id             String    @id @default(cuid())
  participantIds Int[]
  productId      String
  productTitle   String
  lastMessage    Message?  @relation("ConversationLastMessage", fields: [lastMessageId], references: [id])
  lastMessageId  String?   @unique
  messages       Message[] @relation("ConversationMessages")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Message {
  id                 String        @id @default(cuid())
  conversation       Conversation  @relation("ConversationMessages", fields: [conversationId], references: [id])
  conversationId     String
  lastInConversation Conversation? @relation("ConversationLastMessage")
  sender             User          @relation("UserMessages", fields: [senderId], references: [id])
  senderId           Int
  text               String
  timestamp          DateTime      @default(now())
  isRead             Boolean       @default(false)
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  type      String
  message   String
  relatedId String
  title     String
  isRead    Boolean  @default(false)
  timestamp DateTime @default(now())
}

model Watchlist {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([userId, productId])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)

  @@unique([userId, productId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    ProductCategory[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([productId, categoryId])
}

model Dispute {
  id           String        @id @default(cuid())
  order        Order         @relation(fields: [orderId], references: [id])
  orderId      String
  productTitle String
  user         User          @relation(fields: [userId], references: [id])
  userId       Int
  reason       String
  status       DisputeStatus @default(OPEN)
  createdAt    DateTime      @default(now())
}

// Content monetization models

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  imageUrl    String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
  category    NewsCategory? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      NewsImage[]
  videos      NewsVideo[]
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  advertiser  String?
  imageUrl    String?
  targetUrl   String
  placement   String   // e.g. homepage-hero, sidebar, banner-top
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Images attached to News entries, stored as binary blobs in Postgres
model NewsImage {
  id        String  @id @default(cuid())
  news      News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    String
  data      Bytes
  mimeType  String
  position  Int     @default(0)
  createdAt DateTime @default(now())
}

/// YouTube videos attached to News entries
model NewsVideo {
  id        String  @id @default(cuid())
  news      News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    String
  youtubeId String
  position  Int     @default(0)
  createdAt DateTime @default(now())
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  description String?
  news      News[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRoleAssignment {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  role      UserRole
  assignedBy Int?    // User ID who assigned this role
  assignedAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@unique([userId, role])
}

/// Exchange rates parsed from text messages
model ExchangeRate {
  id           String   @id @default(cuid())
  base         String
  quote        String
  buyRate      Int?
  sellRate     Int?
  // Tiered per 100k MMK rates
  buyBelow1mPer100k  Int?
  buyAbove1mPer100k  Int?
  sellBelow1mPer100k Int?
  sellAbove1mPer100k Int?
  sellSpecial100to500 String?
  paymentMethod   String?
  dateText        String?
  notes           Json?
  sourceText   String
  sellSamples  Json?
  buySamples   Json?
  allSamples   Json?
  parsedAt     DateTime @default(now())
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdById  Int
  createdAt    DateTime @default(now())

  @@index([base, quote, createdAt])
}

// Lightweight support chat for Currex site
model WebChatSession {
  id            String           @id @default(cuid())
  sessionKey    String           @unique
  createdAt     DateTime         @default(now())
  lastActivityAt DateTime        @updatedAt
  messages      WebChatMessage[]
}

model WebChatMessage {
  id         String          @id @default(cuid())
  session    WebChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  author     String          // 'client' | 'admin'
  text       String
  timestamp  DateTime        @default(now())
}
